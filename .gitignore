# =============================================================================
# HYPERVIEW2 Challenge - Git Ignore File
# =============================================================================

# =============================================================================
# PROJECT-SPECIFIC
# =============================================================================

# Dataset (raw imagery can be multiple GBs!) - exceptions for gt csv/wavelengths below
data/*
data/raw/*
*.npz

# Trained models + preprocessors (config: train.model_dir = "features")
features/
*.pkl
*.joblib

# Logs (config: validation.log_dir = "logs")
logs/
*.log

# Generated CSVs (submission, XAI residuals/importances) - exceptions below
*.csv

# Temporary work
scratch/
temp/

# =============================================================================
# PYTHON
# =============================================================================

__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.env
.venv
env/
venv/

# Jupyter
.ipynb_checkpoints

# =============================================================================
# IDEs and Editors
# =============================================================================

.idea/
.vscode/
.spyderproject
.spyproject

# =============================================================================
# OS Generated Files
# =============================================================================

.DS_Store
Thumbs.db
desktop.ini

# =============================================================================
# KEEP SPECIFIC FILES (EXCEPTIONS)
# =============================================================================

!.gitkeep
!**/README.md
!config.yaml.example

# Data: keep wavelengths + ground truth + generated submission, ignore raw imagery
!data/wavelengths.json
!data/raw/
!data/raw/train_gt.csv
!data/submission.csv

# Keep XAI outputs (plots + CSVs) - tracked in full
!xai_results/
!xai_results/**
